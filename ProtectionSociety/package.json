{
  "name": "ProtectionSociety-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "npm install --prefix client",
    "api": "lsof -t -i :3001 | xargs kill -9 && json-server --watch db.json --port 3001",
    "client": "lsof -t -i :5173 | xargs kill -9 && npm run dev --prefix client",
    "start": "npm-run-all --parallel api client"
  },
  "dependencies": {
    "json-server": "^1.0.0-beta.1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
